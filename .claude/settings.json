{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(pwd)\" != \"/d/dev/rohkai\" ] && [ \"$(pwd)\" != \"D:\\\\dev\\\\rohkai\" ]; then echo \"WARNING: CWD is $(pwd), not D:\\dev\\rohkai\"; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo clippy --quiet 2>&1 | head -20"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(cargo:*)", "Bash(git:*)"],
    "deny": ["Bash(rm -rf*)"]
  }
}
