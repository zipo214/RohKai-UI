{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File D:\\dev\\rohkai\\scripts\\snapshot-context.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File D:\\dev\\rohkai\\scripts\\preflight-context.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Set-Location D:\\dev\\rohkai; cargo clippy --quiet 2>&1 | Select-Object -First 20\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(cargo:*)", "Bash(git:*)"],
    "deny": ["Bash(rm -rf*)"]
  }
}
